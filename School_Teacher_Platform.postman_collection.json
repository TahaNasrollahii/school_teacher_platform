    {
      "name": "🤝 Recommender",
      "description": "Recommendation engine, match listings, status workflow, and statistics.",
      "item": [
        {
          "name": "Get School Matches",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    if (json.results && json.results.length > 0) {",
                  "        pm.collectionVariables.set('match_id', String(json.results[0].id));",
                  "        pm.test('Matches returned', () => pm.expect(json.count).to.be.at.least(1));",
                  "    } else {",
                  "        pm.test('No matches yet – run Refresh first', () => pm.expect(json.count).to.be.at.least(1));",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Token {{school_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/recommend/school-matches/",
              "host": ["{{base_url}}"],
              "path": ["api", "recommend", "school-matches", ""],
              "query": [
                { "key": "min_score", "value": "30", "disabled": true, "description": "Minimum match score threshold (0-100, default 30)" },
                { "key": "subject_id", "value": "1", "disabled": true, "description": "Filter by specific SubjectNeed ID" },
                { "key": "page", "value": "1", "disabled": true }
              ]
            },
            "description": "Return the ranked list of teacher suggestions for the authenticated school.\n\nThe engine runs automatically on first access if no matches exist yet.\n\nThe first result's `id` is stored in `match_id` for use in status update requests."
          }
        },
